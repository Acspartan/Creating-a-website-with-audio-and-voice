# Copy to .env.local and fill in values from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (no NEXT_PUBLIC_ prefix): used to check tokens. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket that will hold the recordings.
NEXT_PUBLIC_SUPABASE_BUCKET=recordings
